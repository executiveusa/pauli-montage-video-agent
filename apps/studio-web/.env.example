# Montage owner authentication
MONTAGE_OWNER_EMAIL=owner@example.com
# Preferred format: scrypt:<salt>:<128-char-hex-derived-key>
MONTAGE_OWNER_PASSWORD_HASH=
# Optional compatibility fallback. Prefer the hash above in production.
MONTAGE_OWNER_PASSWORD=
# Required. Use at least 32 random characters.
MONTAGE_SESSION_SECRET=

# Set this to use hosted signup, recovery, signed sessions, and workspace ownership.
# Leave unset for the legacy single-owner local session.
YAPPY_STUDIO_API_URL=http://127.0.0.1:8000
