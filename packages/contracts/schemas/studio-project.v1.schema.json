{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yappyverse.studio/schemas/studio-project.v1.schema.json",
  "title": "YAPPY-CLIPZ StudioProject v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "project", "brief", "assets", "elements", "scenes", "shots",
    "timeline", "jobs", "approvals", "decisions", "events", "renders", "exports"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "slug", "title", "status", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tenantId": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "status": {"enum": ["draft", "active", "paused", "completed", "archived"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": ["string", "null"]}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "audience", "deliverables", "qualityLane"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "items": {"type": "string"}},
        "deliverables": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "qualityLane": {"enum": ["economy", "premium", "sovereign", "owner_private"]},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "referenceAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "budget": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "number", "minimum": 0},
            "currency": {"type": "string", "minLength": 3, "maxLength": 3}
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"]},
        "voice": {"type": ["string", "null"]},
        "colors": {"type": "array", "items": {"type": "string"}},
        "typography": {"type": "array", "items": {"type": "string"}},
        "logoAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRefs": {"type": "array", "items": {"type": "string"}},
        "sourceAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": ["string", "null"]}
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "text": {"type": ["string", "null"]},
        "assetId": {"type": ["string", "null"]},
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order", "summary"],
            "properties": {
              "id": {"type": "string"},
              "order": {"type": "integer", "minimum": 0},
              "summary": {"type": "string"},
              "sceneIds": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "assets": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/asset.v1.schema.json"}},
    "elements": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/element.v1.schema.json"}},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "shotIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "intent": {"type": ["string", "null"]},
          "locationElementId": {"type": ["string", "null"]},
          "elementIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "shotIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "extensions": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sceneId", "order", "description", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sceneId": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0},
          "description": {"type": "string", "minLength": 1},
          "intent": {"type": ["string", "null"]},
          "durationSeconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "status": {"enum": ["planned", "approved", "generating", "generated", "editing", "locked", "rejected"]},
          "elementIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "referenceAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "generatedAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "providerDecisionId": {"type": ["string", "null"]},
          "approvalIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "camera": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "shotSize": {"type": ["string", "null"]},
              "angle": {"type": ["string", "null"]},
              "movement": {"type": ["string", "null"]},
              "lens": {"type": ["string", "null"]}
            }
          },
          "dialogue": {"type": "array", "items": {"type": "string"}},
          "extensions": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "voice": {"type": "object", "additionalProperties": true},
    "music": {"type": "object", "additionalProperties": true},
    "sound": {"type": "object", "additionalProperties": true},
    "captions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "timeline": {"$ref": "https://yappyverse.studio/schemas/timeline.v1.schema.json"},
    "jobs": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/job.v1.schema.json"}},
    "approvals": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/approval.v1.schema.json"}},
    "decisions": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/decision.v1.schema.json"}},
    "events": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/event.v1.schema.json"}},
    "renders": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/render.v1.schema.json"}},
    "exports": {"type": "array", "items": {"$ref": "https://yappyverse.studio/schemas/export.v1.schema.json"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRefs": {"type": "array", "items": {"type": "string"}},
        "decisionIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "eventIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
