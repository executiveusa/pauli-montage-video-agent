{
  "id": "montage",
  "role": "film_studio",
  "version": "0.1.0",
  "repository": "executiveusa/pauli-montage-video-agent",
  "capabilities": [
    "video.ingest",
    "video.transcribe",
    "video.edit.apply",
    "video.render",
    "video.verify"
  ],
  "interfaces": {
    "api": "http://127.0.0.1:4788",
    "mcp": false,
    "cli": false,
    "browser": false,
    "gui": false
  },
  "owns": [
    "video_project_state"
  ],
  "requires_approval": [
    "external.publish",
    "source.delete",
    "major.production.path.change"
  ],
  "health": {
    "mode": "http",
    "target": "http://127.0.0.1:4788/health",
    "interval_seconds": 60
  },
  "events": {
    "emits": [
      "work.started",
      "work.blocked",
      "artifact.created",
      "review.required",
      "video.render.ready",
      "work.completed"
    ],
    "consumes": [
      "work.assigned",
      "approval.requested"
    ]
  },
  "evidence": {
    "receipt_version": "v0"
  },
  "metadata": {
    "registry_scope": "agenix_hive_external",
    "montage_runtime_registry": "yappy_clipz.capabilities.default_registry",
    "canonical_project_contract": "StudioProject v1",
    "source_media_immutable": true,
    "enabled_interface_order": ["api"],
    "mcp_status": "not_claimed_until_the_local_media_capabilities_are_registered_in_the_existing_Montage_capability_registry_and_runtime-probed",
    "director_status": "video.edit.propose intentionally excluded until the Director proposal engine is implemented",
    "capability_bindings": {
      "video.ingest": {
        "status": "available",
        "surface": "scripts/montage_local_service.py",
        "request": "POST /assets"
      },
      "video.transcribe": {
        "status": "conditional",
        "surface": "scripts/montage_local_service.py",
        "request": "POST /operations operation=transcribe",
        "condition": "health.fasterWhisper == true"
      },
      "video.edit.apply": {
        "status": "available",
        "surface": "tools.local_footage.LocalFootageTool",
        "operations": ["cut", "reframe_vertical", "burn_captions", "write_srt"]
      },
      "video.render": {
        "status": "available",
        "surface": "tools.local_footage.LocalFootageTool",
        "operations": ["cut", "reframe_vertical", "burn_captions"]
      },
      "video.verify": {
        "status": "available",
        "surface": "tools.local_footage.LocalFootageTool",
        "operation": "verify"
      }
    }
  }
}
